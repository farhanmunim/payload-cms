# A generated secret for Payload — generate with: openssl rand -hex 32
PAYLOAD_SECRET=

# SQLite database location (libSQL URL). Relative paths resolve from the
# server's working directory (/app in the Docker container).
DATABASE_URI=file:./data/payload.db

# Email via Resend (https://resend.com). Optional — without an API key,
# emails (e.g. password resets) are logged to the console instead of sent.
RESEND_API_KEY=
# Must be on a domain verified in your Resend account
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=
